{
	"name": "stillwater",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "Every open pull request, issue and failing build across all your GitHub repos, in one place. Local-first: your tokens never leave your browser.",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "npm run build && wrangler dev",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "node --test tests/*.test.ts",
		"deploy": "npm run build && wrangler deploy"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.19.2",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"wrangler": "^4.157.0"
	}
}
