{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "stillwater",
	"compatibility_date": "2026-11-01",
	// Static files only. There is no server code: the app runs in your browser
	// and talks to GitHub (and your own Stillwater Monitor, if you connect one)
	// directly. dist/_headers carries the security headers; see vite.config.ts.
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	}
}
